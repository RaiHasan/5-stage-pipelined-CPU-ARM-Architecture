
`timescale 1ns/10ps
module mux_32_1 (dataIn, selectors, dataOut);
	input logic [31:0] dataIn;
	input logic [4:0] selectors;
	
	wire [15:0] selctedOne;
	wire [7:0] selectedTwo;
	wire [3:0] selectedThree;
	wire [1:0] selectedFour;
	
	
	
	genvar i
	
	generate
		for (i = 0; i < 31; i += 2) begin : selectedOneLoop
			mux_2_1 m1 (.out(selectedOne[i]), .in1(dataIn[i+1]), .in0(dataIn[i]), .sel(selectors[0]));
		end
	endgenerate 
	
	
	genvar j
	
	generate
		for (j = 0; j < 15; j += 2) begin : selectedTwoLoop
			mux_2_1 m2 (.out(selectedTwo[j]), .in1(selectedOne[j+1]), .in0(selectedOne[j]), .sel(selectors[1]));
		end
	endgenerate 
	
	
	genvar k
	
	generate
		for (k = 0; k < 7; k += 2) begin : selectedThreeLoop
			mux_2_1 m3 (.out(selectedThree[k]), .in1(selectedTwo[k+1]), .in0(selectedTwo[k]), .sel(selectors[2]));
		end
	endgenerate 
	
	
	genvar a
	
	generate
		for (a = 0; a < 3; a += 2) begin : selectedFourLoop
			mux_2_1 m4 (.out(selectedFour[a]), .in1(selectedThree[a+1]), .in0(selectedThree[a]), .sel(selectors[3]));
		end
	endgenerate 
	
	mux_2_1 m4 (.out(dataOut), .in1(selectedFour[1]), .in0(selectedFour[0]), .sel(selectors[4]));
	
	
	
	
	