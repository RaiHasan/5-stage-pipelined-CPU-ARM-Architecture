

module register_64Bit_tb();
	logic [63:0] dataIn;
	logic enable, reset, clk;
	logic [63:0] dataOut;
	
	initial begin // Set up the clock
		clk <= 0;
		forever #(ClockDelay/2) clk <= ~clk;
	end
	
	register_64Bit dut (.*);
	
	
	initial begin
		enable <= 0; reset <= 1; dataIn <= 64'd0 @(posedge clk);
		enable <= 1; reset <= 0; dataIn <= 64'd18446744073709551615 @(posedge clk);
		enable <= 0; reset <= 0; dataIn <= 64'd20 @(posedge clk);
		enable <= 1; reset <= 0; dataIn <= 64'd200 @(posedge clk);
		enable <= 1; reset <= 1; dataIn <= 64'd200 @(posedge clk);
		enable <= 1; reset <= 1; dataIn <= 64'd200 @(posedge clk);
		
		
		
		$stop;
	end
endmodule
	