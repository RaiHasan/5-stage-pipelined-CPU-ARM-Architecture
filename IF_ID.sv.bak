

module IF_ID (instructionIN, PCin, instructionOut, PCout, reset, clk);
	input logic [31:0] instructionIN;
	input logic [63:0] PCin;
	input logic clk, reset;
	output logic [31:0] instructionOut;
	output logic [63:0] PCout;
	
	register_32Bit instructionReg (.dataIn(instructionIN), .enable(1'b1), .reset, 
		.clk, .dataOut(instructionOut));
	
	register_64Bit PCValReg (.dataIn(PCin), .enable(1'b1), .reset, .clk, .dataOut(PCout));

endmodule 
	
	
	
	
	
	
	
	