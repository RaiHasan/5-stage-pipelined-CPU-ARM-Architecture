
`timescale 1ns/10ps
module CPU_single (reset, clk);
	input logic reset, clk;
	
	logic [63:0] pcWire, IMAddr;
	logic [31:0] instruction;
	logic reg2Loc, Branch, condBranch, ALUsrc, memAddr, loadReg, memRead, memWrite, setFlag;
	logic [2:0] aluCtrl;
	
	register_64Bit PC (.dataIn(pcWire), .enable(1'b1), .reset, .clk, .dataOut(IMAddr));
	
	instructmem IM (.address(IMAddr), .instruction, .clk);
	
	control_unit CU(.instruction(instruction[31:21]), .reg2Loc, .Branch,
	.condBranch, .ALUsrc, .memAddr, .loadReg, .memRead, .memWrite, .aluCtrl, .setFlag);
	
	
	
	
	