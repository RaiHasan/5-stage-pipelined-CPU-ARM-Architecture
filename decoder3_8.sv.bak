
`timescale 1ns/10ps
module decoder3_8 (dataInput, dataOutput, selectors);
	input logic dataInput;
	input logic [2:0] selectors;
	output logic [7:0] dataOutput;
	
	wire invertedSelector2;
	wire invertedSelector1;
	wire invertedSelector0;
	
	not gate1 (invertedSelctor2, selectors[2]);
	not gate2 (invertedSelctor1, selectors[1);
	not gate3 (invertedSelctor0, selectors[0]);
	
	wire [7:0] decoderOutput;
	
	and gate4 (decoderOutput[0], invertedSelector2, invertedSelector1, invertedSelector0);
	
endmodule 
	
	
	