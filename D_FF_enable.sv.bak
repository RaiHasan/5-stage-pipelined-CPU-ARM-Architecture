

module D_FF_enable (q, d, reset, clk, enable);
	input logic d, reset, clk, enable; 
	output logic q;
	
	wire enableInversed;
	wire oldDataEnabled;
	wire newDataEnabled;
	
	wire dataOut;
	wire dataIn;
	
	D_FF flip_flop (.q(dataOut), .d(dataIn), .reset, .clk);
	
	NOT gateOne (enableInversed, enable);
	
	AND gateTwo (oldDataEnabled, enableInversed, dataOut);
	
	AND gateThree (newDataEnabled, enable, d);
	
	OR  gateFour (dataIn, oldDataEnabled, newDataEnabled);
	
	assign q = dataOut;

	
endmodule 