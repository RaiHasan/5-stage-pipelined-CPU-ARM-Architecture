
`timescale 1ns/10ps
module CPU_single_tb();
	logic reset, clk;
	
	parameter ClockDelay = 500000;
	
	CPU_single dut (.*);
	
	initial begin // Set up the clock
		clk <= 0;
		forever #(ClockDelay/2) clk <= ~clk;
	end

	initial $timeformat(-9, 2, " ns", 10);
	
	initial begin
		reset <= 1'b1;
		 #100000;
		 reset <= 1'b0;
		 #100000000000000000000;
		 $stop;
	end
endmodule

		