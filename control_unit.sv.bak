
`timescale 1ns/10ps
module control_unit(instruction, reg2Loc, Branch,
	condBranch, ALUsrc, memAddr, loadReg, memRead, memWrite, aluCtrl);
	input logic [10:0] instruction;
	output logic reg2Loc, Branch, condBranch, ALUsrc, memAddr, loadReg, memRead, memWrite, setFlag;
	output logic [2:0] aluCtrl;
	
	always_comb begin
		// 11 bit opcode (R and D type)
		case(instruction)
			//ADD
			11'h458: begin
				reg2Loc = 1'b0;
				Branch = 1'b0;
				condBranch = 1'b0;
				ALUsrc = 1'b0;
				memAddr = 1'b0;
				loadReg = 1'b0;
				memRead = 1'b0;
				memWrite = 1'b0;
				setFlag = 1'b0;
				aluCtrl = 3'b010;
			end
		   //ADD and Set flags
			11'h558: begin
				reg2Loc = 1'b0;
				Branch = 1'b0;
				condBranch = 1'b0;
				ALUsrc = 1'b0;
				memAddr = 1'b0;
				loadReg = 1'b0;
				memRead = 1'b0;
				memWrite = 1'b0;
				setFlag = 1'b1;
				aluCtrl = 3'b010;
			end
			//reg to branch
			11'h6B0: begin
				reg2Loc = 1'b0;
				Branch = 1'b0;
				condBranch = 1'b0;
				ALUsrc = 1'b0;
				memAddr = 1'b0;
				loadReg = 1'b0;
				memRead = 1'b0;
				memWrite = 1'b0;
				setFlag = 1'b0;
				aluCtrl = 3'b001;
			end
			//load to reg
			11'h7C2: begin
				reg2Loc = 1'b0;
				Branch = 1'b0;
				condBranch = 1'b0;
				ALUsrc = 1'b1;
				memAddr = 1'b1;
				loadReg = 1'b1;
				memRead = 1'b1;
				memWrite = 1'b0;
				setFlag = 1'b0;
				aluCtrl = 3'b010;
			end
			
			//load to mem (stur)
			11'h7C0: begin
				reg2Loc = 1'b1;
				Branch = 1'b0;
				condBranch = 1'b0;
				ALUsrc = 1'b1;
				memAddr = 1'b1;
				loadReg = 1'b0;
				memRead = 1'b0;
				memWrite = 1'b1;
				setFlag = 1'b0;
				aluCtrl = 3'b010;
			end
			
			//SUBS
			11'h758: begin
				reg2Loc = 1'b0;
				Branch = 1'b0;
				condBranch = 1'b0;
				ALUsrc = 1'b0;
				memAddr = 1'b0;
				loadReg = 1'b0;
				memRead = 1'b0;
				memWrite = 1'b0;
				setFlag = 1'b1;
				aluCtrl = 3'b010;
			end
			
		endcase 
			//10 bit instruction I type
		case(instruction[10:1])
			//ADDI
			10'b1001000100: begin
				reg2Loc = 1'b0;
				Branch = 1'b0;
				condBranch = 1'b0;
				ALUsrc = 1'b1;
				memAddr = 1'b0;
				loadReg = 1'b0;
				memRead = 1'b0;
				memWrite = 1'b0;
				setFlag = 1'b0;
				aluCtrl = 3'b010;
			end
		endcase
		
		//6 bit instruction B type 
		case(instruction[10:5])
			//regular branch
			6'b000101: begin
				reg2Loc = 1'b0;
				Branch = 1'b1;
				condBranch = 1'b0;
				ALUsrc = 1'b0;
				memAddr = 1'b0;
				loadReg = 1'b0;
				memRead = 1'b0;
				memWrite = 1'b0;
				setFlag = 1'b0;
				aluCtrl = 3'b001;
			end
			//Branch link 
			6'b100101: begin
				reg2Loc = 1'b0;
				Branch = 1'b1;
				condBranch = 1'b0;
				ALUsrc = 1'b0;
				memAddr = 1'b0;
				loadReg = 1'b0;
				memRead = 1'b0;
				memWrite = 1'b0;
				setFlag = 1'b0;
				aluCtrl = 3'b001;
			end
		endcase
		
		//8 bit instruction CB type 
		case(instruction[10:3])
		   //branch conditional
			8'b01110100: begin
				reg2Loc = 1'b0;
				Branch = 1'b0;
				condBranch = 1'b1;
				ALUsrc = 1'b0;
				memAddr = 1'b0;
				loadReg = 1'b0;
				memRead = 1'b0;
				memWrite = 1'b0;
				setFlag = 1'b0;
				aluCtrl = 3'b001;
			end
			
			//branch conditional if register is zero 
			8'b10110100: begin
				reg2Loc = 1'b0;
				Branch = 1'b0;
				condBranch = 1'b1;
				ALUsrc = 1'b0;
				memAddr = 1'b0;
				loadReg = 1'b0;
				memRead = 1'b0;
				memWrite = 1'b0;
				setFlag = 1'b0;
				aluCtrl = 3'b001;
			end
		endcase
		
		default: begin
				reg2Loc = 1'b0;
				Branch = 1'b0;
				condBranch = 1'b0;
				ALUsrc = 1'b0;
				memAddr = 1'b0;
				loadReg = 1'b0;
				memRead = 1'b0;
				memWrite = 1'b0;
				setFlag = 1'b0;
				aluCtrl = 3'b001;
			end
	end
	
			
			
			
			
			
			